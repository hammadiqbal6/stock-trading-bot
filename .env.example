# =============================================================================
# AI Stock Trading Bot — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
API_HOST=0.0.0.0
API_PORT=8000

# --- Trading mode (paper by default; live requires explicit flag + confirmation) ---
TRADING_MODE=paper
# LIVE_TRADING_ENABLED=false
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISKS

# --- Alpaca (required for paper trading & live market data) ---
# Signup: https://app.alpaca.markets/signup (paper-only accounts open worldwide, incl. Pakistan)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex

# --- Finnhub (optional but recommended for company news; free 60/min) ---
# Signup: https://finnhub.io/register
FINNHUB_API_KEY=

# --- LLM providers (optional; FinBERT local is always available) ---
# Groq free tier default: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Ollama (local, no key): http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Active LLM provider: none | groq | ollama | openai_compatible
LLM_PROVIDER=none

# OpenAI-compatible optional endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# --- Risk defaults (overridable in config/settings.yaml) ---
MAX_POSITION_PCT=0.10
DAILY_LOSS_CAP_PCT=0.02
MAX_DRAWDOWN_PCT=0.15
VOL_TARGET_ANNUAL=0.12

# --- Database / cache paths ---
DATA_DIR=./data
CACHE_DIR=./data/cache
MODEL_DIR=./data/models
LOG_DIR=./logs

# --- Feature flags ---
ENABLE_ML_MODEL=false
ENABLE_NEWS_SENTIMENT=true
ENABLE_TRADING_AGENTS_ADVISORY=false
ENABLE_SCHEDULER=true
